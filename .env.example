# Local development credentials. Replace before using a shared environment.
POSTGRES_DB=firescope
POSTGRES_USER=firescope
POSTGRES_PASSWORD=firescope_local
DATABASE_URL=postgresql+psycopg://firescope:firescope_local@localhost:5432/firescope
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]
APP_ENV=development
# Optional NASA FIRMS recent-data API key. Server/CLI only; never use a VITE_ prefix.
MAP_KEY=
# Gemini is server-only. Never prefix its key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-4-hydrogen
AI_REQUESTS_PER_MINUTE=8
AI_REQUESTS_PER_DAY=100
AI_CONCURRENT_REQUESTS=2
VITE_API_BASE_URL=/api/v1
# Blank uses Esri World Imagery with World Boundaries and Places.
# Optionally set a public or self-hosted MapLibre style URL.
VITE_MAP_STYLE_URL=
